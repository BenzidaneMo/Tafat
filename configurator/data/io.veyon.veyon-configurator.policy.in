<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>

  <action id="@BRANDING_APP_ID_PREFIX@.pkexec.@BRANDING_PRODUCT_SLUG@-configurator">
    <description>@BRANDING_PRODUCT_NAME@ Configurator</description>
    <message>Authentication is required to run the @BRANDING_PRODUCT_NAME@ Configurator</message>
    <message xml:lang="de">Für die Ausführung des @BRANDING_PRODUCT_NAME@ Configurators ist eine Authentifizierung erforderlich</message>
    <icon_name>@BRANDING_PRODUCT_SLUG@-configurator</icon_name>
    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@CMAKE_INSTALL_PREFIX@/bin/@BRANDING_PRODUCT_SLUG@-configurator</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
