[Unit]
Description=@BRANDING_PRODUCT_NAME@ Service
After=network-online.target dbus.service systemd-logind.service
Wants=network-online.target
Requires=dbus.service systemd-logind.service
Documentation=@BRANDING_WEBSITE@

[Service]
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/@BRANDING_PRODUCT_SLUG@-service
Type=simple
Restart=always
StartLimitInterval=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target

