######################################################################

Section "${APP_NAME} Service" SEC_SERVICE
SectionIn RO
${INSTALL_TYPE}
ClearErrors
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service unregister'
${If} $0 != 0
  ExecWait '"$INSTDIR\veyon-ctl.exe" service unregister'
${EndIf}
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\plugins\*.dll"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\translations"
SetOverwrite on
SetOutPath "$INSTDIR"
# core components
File "@BRANDING_PRODUCT_SLUG@-server.exe"
File "@BRANDING_PRODUCT_SLUG@-service.exe"
File "@BRANDING_PRODUCT_SLUG@-configurator.exe"
File "@BRANDING_PRODUCT_SLUG@-cli.exe"
File "@BRANDING_PRODUCT_SLUG@-wcli.exe"
File "@BRANDING_PRODUCT_SLUG@-worker.exe"
File "*.dll"
File "LICENSE.TXT"
File "README.TXT"
File "NotoSansTifinagh-OFL.TXT"
# plugins
SetOutPath "$INSTDIR\plugins"
File "plugins/*.dll"
# translations
SetOutPath "$INSTDIR\translations"
File "translations/*.qm"
# QCA plugins
SetOutPath "$INSTDIR\crypto"
File "crypto/*.dll"
# Qt image format plugin
SetOutPath "$INSTDIR\imageformats"
File "imageformats/qjpeg.dll"
# Qt platform plugin
SetOutPath "$INSTDIR\platforms"
File "platforms/qwindows.dll"
SetOutPath "$INSTDIR\styles"
File "styles/*.dll"
# Qt TLS backend
SetOutPath "$INSTDIR\tls"
File "tls/qopensslbackend.dll"
# configuration
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service register'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Network/FirewallExceptionEnabled 1'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Windows/SoftwareSASEnabled 1'
# disable forced guest logon as otherwise logon authentication fails
WriteRegDWORD ${REG_ROOT} "SYSTEM\CurrentControlSet\Control\Lsa"  "ForceGuest" "0"
${GetParameters} $R0
${GetOptions} $R0 "/ApplyConfig=" $R1
${If} $R1 != ""
  ClearErrors
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config import "$R1"' $0
  ${If} $0 != 0
	   MessageBox MB_OK|MB_ICONSTOP "Could not apply specified configuration file!"
  ${EndIf}
${EndIf}
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service start'
SectionEnd

Section "${APP_NAME} Master" SEC_MASTER
${INSTALL_TYPE}
SetOutPath "$INSTDIR"
File "@BRANDING_PRODUCT_SLUG@-master.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\${APP_NAME}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
${EndIf}
CreateShortCut "$DESKTOP\${APP_NAME} Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
SectionEnd

Section "Interception driver" SEC_INTERCEPTION
${INSTALL_TYPE}
SetOutPath "$INSTDIR\interception"
File "interception/*"
SectionEnd

Function RunConfigurator
	Exec '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-configurator.exe"'
FunctionEnd


######################################################################

Function .onInit
${GetParameters} $R0
${GetOptions} $R0 "/NoMaster" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
${GetOptions} $R0 "/NoInterception" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_INTERCEPTION}
${EndIf}
UserInfo::GetAccountType
pop $0
${If} $0 != "admin"
	MessageBox mb_iconstop "Please run the installer with administrative rights!"
	SetErrorLevel 740 ;ERROR_ELEVATION_REQUIRED
	Quit
${EndIf}
!if ${IS_64BIT} == 1
${IfNot} ${RunningX64}
	MessageBox mb_iconstop "This installer is for 64-bit Windows. Please use the 32-bit (win32) installer of ${APP_NAME} on this computer." /SD IDOK
	SetErrorLevel 216 ;ERROR_EXE_MACHINE_TYPE_MISMATCH
	Quit
${EndIf}
!endif
!if ${MIN_WINDOWS} == 10
${IfNot} ${AtLeastWin10}
	MessageBox mb_iconstop "This version of ${APP_NAME} requires Windows 10 or newer. Please use the legacy installer (win32-legacy or win64-legacy) on Windows 7 and 8.1." /SD IDOK
	SetErrorLevel 1150 ;ERROR_OLD_WIN_VERSION
	Quit
${EndIf}
!else
${IfNot} ${AtLeastWin7}
	MessageBox mb_iconstop "${APP_NAME} requires Windows 7 or newer." /SD IDOK
	SetErrorLevel 1150 ;ERROR_OLD_WIN_VERSION
	Quit
${EndIf}
!endif
FunctionEnd

######################################################################

Section -Icons_Reg
SetOutPath "$INSTDIR"
WriteUninstaller "$INSTDIR\uninstall.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\${APP_NAME}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Configurator.lnk" "$INSTDIR\@BRANDING_PRODUCT_SLUG@-configurator.exe"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\Uninstall ${APP_NAME}.lnk" "$INSTDIR\uninstall.exe"
WriteIniStr "$INSTDIR\${APP_NAME} website.url" "InternetShortcut" "URL" "${WEB_SITE}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Website.lnk" "$INSTDIR\${APP_NAME} website.url"
${EndIf}

WriteRegStr ${REG_ROOT} "${REG_APP_PATH}" "" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayName" "${APP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "UninstallString" "$INSTDIR\uninstall.exe"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayIcon" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayVersion" "${VERSION}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "Publisher" "${COMP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "URLInfoAbout" "${WEB_SITE}"
SectionEnd

######################################################################

Section Uninstall
${INSTALL_TYPE}

ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Service/SoftwareSASEnabled 0'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Network/FirewallExceptionEnabled 0'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service unregister'
ExecWait '"$INSTDIR\interception\install-interception.exe" /uninstall'
# make sure the service is stopped and all file handles are released
Sleep 2000

${GetParameters} $R0
${GetOptions} $R0 "/ClearConfig" $R1
${IfNot} ${Errors}
	ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config clear'
${EndIf}

Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.TXT"
Delete "$INSTDIR\*.url"
RmDir /r "$INSTDIR\crypto"
RmDir /r "$INSTDIR\imageformats"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\platforms"
RmDir /r "$INSTDIR\styles"
RmDir /r "$INSTDIR\tls"
RmDir /r "$INSTDIR\translations"
RmDir /r "$INSTDIR\interception"

RmDir "$INSTDIR"

Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Master.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Configurator.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\Uninstall ${APP_NAME}.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Website.lnk"
RmDir "$SMPROGRAMS\${APP_NAME}"

Delete "$DESKTOP\${APP_NAME} Master.lnk"

DeleteRegKey ${REG_ROOT} "${REG_APP_PATH}"
DeleteRegKey ${REG_ROOT} "${UNINSTALL_PATH}"
SectionEnd

######################################################################

Function un.onInit
!insertmacro MUI_UNGETLANGUAGE
FunctionEnd

