LangString DESC_SEC_SERVICE ${LANG_ENGLISH} "${APP_NAME} service and common files required on all computers"
LangString DESC_SEC_SERVICE ${LANG_GERMAN} "${APP_NAME}-Dienst und gemeinsame Dateien, die auf allen Computern benötigt werden"
LangString DESC_SEC_MASTER ${LANG_ENGLISH} "Master application for monitoring and controlling ${APP_NAME} client computers"
LangString DESC_SEC_MASTER ${LANG_GERMAN} "Master-Applikation zum Beobachten und Steuern von ${APP_NAME}-Client-Computern"
LangString DESC_SEC_INTERCEPTION ${LANG_ENGLISH} "Special input device driver required for intercepting keyboard shortcuts such as Ctrl+Alt+Del in screen lock mode"
