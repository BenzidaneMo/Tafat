######################################################################

Section "${APP_NAME} Service" SEC_SERVICE
SectionIn RO
${INSTALL_TYPE}
ClearErrors
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service unregister' $0
${If} $0 != 0
  ExecWait '"$INSTDIR\veyon-ctl.exe" service unregister'
${EndIf}
; Windows deletes the old service only when nothing uses it any more; registering
; before that fails and leaves no service at all once the old one is gone
Call WaitForServiceRemoval
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\plugins\*.dll"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\translations"
SetOverwrite on
SetOutPath "$INSTDIR"
# core components
File "@BRANDING_PRODUCT_SLUG@-server.exe"
File "@BRANDING_PRODUCT_SLUG@-service.exe"
File "@BRANDING_PRODUCT_SLUG@-configurator.exe"
File "@BRANDING_PRODUCT_SLUG@-cli.exe"
File "@BRANDING_PRODUCT_SLUG@-wcli.exe"
File "@BRANDING_PRODUCT_SLUG@-worker.exe"
File "*.dll"
File "LICENSE.TXT"
File "README.TXT"
File "NotoSansTifinagh-OFL.TXT"
# plugins
SetOutPath "$INSTDIR\plugins"
File "plugins/*.dll"
# translations
SetOutPath "$INSTDIR\translations"
File "translations/*.qm"
# QCA plugins
SetOutPath "$INSTDIR\crypto"
File "crypto/*.dll"
# Qt image format plugin
SetOutPath "$INSTDIR\imageformats"
File "imageformats/qjpeg.dll"
# Qt platform plugin
SetOutPath "$INSTDIR\platforms"
File "platforms/qwindows.dll"
SetOutPath "$INSTDIR\styles"
File "styles/*.dll"
# Qt TLS backend
!if ${QT_MAJOR} >= 6
; TLS backends are plugins since Qt 6.2 (Qt 5 has OpenSSL support built in)
SetOutPath "$INSTDIR\tls"
File "tls/qopensslbackend.dll"
!endif
# configuration
Call RegisterService
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Network/FirewallExceptionEnabled 1'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Windows/SoftwareSASEnabled 1'
# disable forced guest logon as otherwise logon authentication fails
WriteRegDWORD ${REG_ROOT} "SYSTEM\CurrentControlSet\Control\Lsa"  "ForceGuest" "0"
${GetParameters} $R0
; settings file ($R5), public key file ($R6) and key name ($R7) to apply
StrCpy $R5 ""
StrCpy $R6 ""
StrCpy $R7 ""
; a student installer carries the settings and the key of the teacher computer
${If} $StudentPackage == 1
  InitPluginsDir
  ClearErrors
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" labsetup extractpackage "$EXEPATH" "$PLUGINSDIR\student"' $0
  ${If} $0 == 0
    StrCpy $R5 "$PLUGINSDIR\student\@BRANDING_PRODUCT_SLUG@-config.json"
    FindFirst $1 $2 "$PLUGINSDIR\student\*_public_key.pem"
    ${If} $2 != ""
      StrCpy $R6 "$PLUGINSDIR\student\$2"
      ; "<name>_public_key.pem" without the 15 characters of "_public_key.pem"
      StrCpy $R7 $2 -15
    ${EndIf}
    FindClose $1
  ${Else}
    MessageBox MB_OK|MB_ICONSTOP "$(STUDENT_PACKAGE_ERROR)" /SD IDOK
    SetErrorLevel 3
  ${EndIf}
${EndIf}
${GetOptions} $R0 "/ApplyConfig=" $R1
${If} $R1 != ""
  StrCpy $R5 $R1
${EndIf}
; /ImportPublicKey=<file> [/PublicKeyName=<name>, default "teacher"]: e.g. from
; the student setup folder exported by the configurator ("Lab setup" page)
${GetOptions} $R0 "/ImportPublicKey=" $R1
${If} $R1 != ""
  StrCpy $R6 $R1
  ${GetOptions} $R0 "/PublicKeyName=" $R7
${EndIf}
${If} $R5 != ""
  ClearErrors
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config import "$R5"' $0
  ${If} $0 != 0
	   MessageBox MB_OK|MB_ICONSTOP "Could not apply specified configuration file!" /SD IDOK
  ${EndIf}
${EndIf}
${If} $R6 != ""
  ${If} $R7 == ""
    StrCpy $R7 "teacher"
  ${EndIf}
  ; replace a key of the same name from a previous installation
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" authkeys delete "$R7/public"'
  ClearErrors
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" authkeys import "$R7/public" "$R6"' $0
  ${If} $0 != 0
    MessageBox MB_OK|MB_ICONSTOP "Could not import the public key $R6!" /SD IDOK
    SetErrorLevel 3
  ${EndIf}
${EndIf}
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service start'
SectionEnd

Section "${APP_NAME} Master" SEC_MASTER
${INSTALL_TYPE}
SetOutPath "$INSTDIR"
File "@BRANDING_PRODUCT_SLUG@-master.exe"

${GetParameters} $R0
; teacher computer: create the key (kept on updates), let normal accounts use it
; and switch to key file authentication, so no settings are needed afterwards
${GetOptions} $R0 "/NoTeacherSetup" $R1
${If} ${Errors}
  ClearErrors
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" labsetup setupteacher' $0
  ${If} $0 != 0
    MessageBox MB_OK|MB_ICONEXCLAMATION "$(TEACHER_SETUP_ERROR)" /SD IDOK
  ${EndIf}
  ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service restart'
${EndIf}
; keep this installer for "Student installer" in ${APP_NAME} Master
${If} $EXEPATH != "$INSTDIR\setup\${INSTALLER_NAME}"
  CreateDirectory "$INSTDIR\setup"
  Delete "$INSTDIR\setup\@BRANDING_PRODUCT_SLUG@-*-setup.exe"
  CopyFiles /SILENT "$EXEPATH" "$INSTDIR\setup\${INSTALLER_NAME}"
${EndIf}

${GetOptions} $R0 "/NoStartMenuFolder" $R1
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\${APP_NAME}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
${EndIf}
CreateShortCut "$DESKTOP\${APP_NAME} Master.lnk" "$INSTDIR\${MAIN_APP_EXE}"
SectionEnd

Section "Interception driver" SEC_INTERCEPTION
${INSTALL_TYPE}
SetOutPath "$INSTDIR\interception"
File "interception/*"
SectionEnd

Function RunMaster
	; through Explorer, so the master runs with the rights of the logged-on user, not as administrator
	Exec '"$WINDIR\explorer.exe" "$INSTDIR\${MAIN_APP_EXE}"'
FunctionEnd

Function FinishPageShow
${IfNot} ${SectionIsSelected} ${SEC_MASTER}
	; nothing to start on a student computer
	SendMessage $mui.FinishPage.Run ${BM_SETCHECK} ${BST_UNCHECKED} 0
	ShowWindow $mui.FinishPage.Run ${SW_HIDE}
${EndIf}
FunctionEnd

Function WaitForServiceRemoval
StrCpy $1 0
${Do}
	; sc.exe fails (1060, ERROR_SERVICE_DOES_NOT_EXIST) once the service is gone
	nsExec::Exec '"$SYSDIR\sc.exe" query ${SERVICE_NAME}'
	Pop $0
	${If} $0 != 0
		${ExitDo}
	${EndIf}
	Sleep 500
	IntOp $1 $1 + 1
${LoopUntil} $1 >= 60
FunctionEnd

Function RegisterService
StrCpy $1 0
${Do}
	ClearErrors
	ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service register' $0
	nsExec::Exec '"$SYSDIR\sc.exe" qc ${SERVICE_NAME}'
	Pop $2
	${If} $0 == 0
	${AndIf} $2 == 0
		${ExitDo}
	${EndIf}
	; the old service may still be marked for deletion
	Call WaitForServiceRemoval
	Sleep 1000
	IntOp $1 $1 + 1
${LoopUntil} $1 >= 5
${If} $2 != 0
	MessageBox MB_OK|MB_ICONSTOP "$(SERVICE_REGISTER_ERROR)" /SD IDOK
	SetErrorLevel 4
${EndIf}
FunctionEnd

Function SkipPageForStudentPackage
${If} $StudentPackage == 1
	Abort
${EndIf}
FunctionEnd

Function DetectStudentPackage
StrCpy $StudentPackage 0
ClearErrors
FileOpen $0 "$EXEPATH" r
${IfNot} ${Errors}
	FileSeek $0 -24 END
	FileRead $0 $1 24
	FileClose $0
	${If} $1 == "${STUDENT_PACKAGE_MARKER}"
		StrCpy $StudentPackage 1
	${EndIf}
${EndIf}
FunctionEnd


######################################################################

Function .onInit
Call DetectStudentPackage
${If} $StudentPackage == 1
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
${GetParameters} $R0
${GetOptions} $R0 "/NoMaster" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_MASTER}
${EndIf}
${GetOptions} $R0 "/NoInterception" $R1
${IfNot} ${Errors}
  !insertmacro UnselectSection ${SEC_INTERCEPTION}
${EndIf}
UserInfo::GetAccountType
pop $0
${If} $0 != "admin"
	MessageBox mb_iconstop "Please run the installer with administrative rights!"
	SetErrorLevel 740 ;ERROR_ELEVATION_REQUIRED
	Quit
${EndIf}
!if ${IS_64BIT} == 1
${IfNot} ${RunningX64}
	MessageBox mb_iconstop "This installer is for 64-bit Windows. Please use the 32-bit (win32) installer of ${APP_NAME} on this computer." /SD IDOK
	SetErrorLevel 216 ;ERROR_EXE_MACHINE_TYPE_MISMATCH
	Quit
${EndIf}
!endif
!if ${MIN_WINDOWS} == 10
${IfNot} ${AtLeastWin10}
	MessageBox mb_iconstop "This version of ${APP_NAME} requires Windows 10 or newer. Please use the legacy installer (win32-legacy or win64-legacy) on Windows 7 and 8.1." /SD IDOK
	SetErrorLevel 1150 ;ERROR_OLD_WIN_VERSION
	Quit
${EndIf}
!else
${IfNot} ${AtLeastWin7}
	MessageBox mb_iconstop "${APP_NAME} requires Windows 7 or newer." /SD IDOK
	SetErrorLevel 1150 ;ERROR_OLD_WIN_VERSION
	Quit
${EndIf}
!endif
FunctionEnd

######################################################################

Section -Icons_Reg
SetOutPath "$INSTDIR"
WriteUninstaller "$INSTDIR\uninstall.exe"

${GetParameters} $R0
${GetOptions} $R0 "/NoStartMenuFolder" $R1
${If} ${Errors}
CreateDirectory "$SMPROGRAMS\${APP_NAME}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Configurator.lnk" "$INSTDIR\@BRANDING_PRODUCT_SLUG@-configurator.exe"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\Uninstall ${APP_NAME}.lnk" "$INSTDIR\uninstall.exe"
WriteIniStr "$INSTDIR\${APP_NAME} website.url" "InternetShortcut" "URL" "${WEB_SITE}"
CreateShortCut "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Website.lnk" "$INSTDIR\${APP_NAME} website.url"
${EndIf}

WriteRegStr ${REG_ROOT} "${REG_APP_PATH}" "" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayName" "${APP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "UninstallString" "$INSTDIR\uninstall.exe"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayIcon" "$INSTDIR\${MAIN_APP_EXE}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "DisplayVersion" "${VERSION}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "Publisher" "${COMP_NAME}"
WriteRegStr ${REG_ROOT} "${UNINSTALL_PATH}"  "URLInfoAbout" "${WEB_SITE}"
SectionEnd

######################################################################

Section Uninstall
${INSTALL_TYPE}

ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Service/SoftwareSASEnabled 0'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config set Network/FirewallExceptionEnabled 0'
ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" service unregister'
ExecWait '"$INSTDIR\interception\install-interception.exe" /uninstall'
# make sure the service is stopped and all file handles are released
Sleep 2000

${GetParameters} $R0
${GetOptions} $R0 "/ClearConfig" $R1
${IfNot} ${Errors}
	ExecWait '"$INSTDIR\@BRANDING_PRODUCT_SLUG@-wcli.exe" config clear'
${EndIf}

Delete "$INSTDIR\*.exe"
Delete "$INSTDIR\*.dll"
Delete "$INSTDIR\*.TXT"
Delete "$INSTDIR\*.url"
RmDir /r "$INSTDIR\crypto"
RmDir /r "$INSTDIR\imageformats"
RmDir /r "$INSTDIR\plugins"
RmDir /r "$INSTDIR\platforms"
RmDir /r "$INSTDIR\styles"
RmDir /r "$INSTDIR\tls"
RmDir /r "$INSTDIR\translations"
RmDir /r "$INSTDIR\interception"
RmDir /r "$INSTDIR\setup"

RmDir "$INSTDIR"

Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Master.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Configurator.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\Uninstall ${APP_NAME}.lnk"
Delete "$SMPROGRAMS\${APP_NAME}\${APP_NAME} Website.lnk"
RmDir "$SMPROGRAMS\${APP_NAME}"

Delete "$DESKTOP\${APP_NAME} Master.lnk"

DeleteRegKey ${REG_ROOT} "${REG_APP_PATH}"
DeleteRegKey ${REG_ROOT} "${UNINSTALL_PATH}"
SectionEnd

